#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='eza -F --color=always --icons=always'
alias la="ls -a"
alias cat='bat'
alias grep='ugrep'
alias vi='nvim'
alias vim='nvim'
alias ..='cd ..'
alias ...='cd ../..'
alias rm='rm -Iv --preserve-root --one-file-system'
alias mv='mv -iv'
alias cp='cp -i'
alias ln='ln -i'
alias chown='chown --preserve-root'
alias chmod='chmod --preserve-root'
alias chgrp='chgrp --preserve-root'
alias mkdir='mkdir -p'

PS1='[\u@\h \W]\$ '
